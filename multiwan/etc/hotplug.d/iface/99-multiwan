#!/bin/sh

# Multi-WAN Hotplug Handler
# 处理接口up/down事件，提供即时响应

# 加载共享函数库
. /lib/multiwan_common.sh

case "$INTERFACE" in
    wan)
        # WAN接口事件处理
        if [ "$ACTION" = "ifup" ]; then
            log "multiwan-hotplug" "Interface $INTERFACE is up; waiting for policy route"
            (sleep 2; setup_route "$INTERFACE" "100" && update_interface_status "$INTERFACE" "up" "hotplug" && { update_special_udp_source "$INTERFACE" || log "multiwan-hotplug" "Warning: failed to refresh WireGuard source address for $INTERFACE"; } && notify_tracker "$INTERFACE") &
        elif [ "$ACTION" = "ifdown" ]; then
            log "multiwan-hotplug" "Interface $INTERFACE is down, updating status immediately"
            # 立即标记接口为down状态并更新路由
            update_interface_status "$INTERFACE" "down" "hotplug"
            # 通知tracker立即检查
            notify_tracker "$INTERFACE"
        fi
        ;;
    vwan1)
        # VWAN接口事件处理
        if [ "$ACTION" = "ifup" ]; then
            log "multiwan-hotplug" "Interface $INTERFACE is up; waiting for policy route"
            (sleep 2; setup_route "$INTERFACE" "200" && update_interface_status "$INTERFACE" "up" "hotplug" && { update_special_udp_source "$INTERFACE" || log "multiwan-hotplug" "Warning: failed to refresh WireGuard source address for $INTERFACE"; } && notify_tracker "$INTERFACE") &
        elif [ "$ACTION" = "ifdown" ]; then
            log "multiwan-hotplug" "Interface $INTERFACE is down, updating status immediately"
            update_interface_status "$INTERFACE" "down" "hotplug"
            notify_tracker "$INTERFACE"
        fi
        ;;
    vwan2)
        # 中国移动接口事件处理
        if [ "$ACTION" = "ifup" ]; then
            log "multiwan-hotplug" "Interface $INTERFACE is up; waiting for policy route"
            (sleep 2; setup_route "$INTERFACE" "400" && update_interface_status "$INTERFACE" "up" "hotplug" && notify_tracker "$INTERFACE") &
        elif [ "$ACTION" = "ifdown" ]; then
            log "multiwan-hotplug" "Interface $INTERFACE is down, updating status immediately"
            update_interface_status "$INTERFACE" "down" "hotplug"
            notify_tracker "$INTERFACE"
        fi
        ;;
    iptv)
        # IPTV接口事件处理
        if [ "$ACTION" = "ifup" ]; then
            log "multiwan-hotplug" "IPTV interface $INTERFACE is up; waiting for policy route"
            (sleep 2; setup_route "$INTERFACE" "300" && update_interface_status "$INTERFACE" "up" "hotplug" && notify_tracker "$INTERFACE") &
        elif [ "$ACTION" = "ifdown" ]; then
            log "multiwan-hotplug" "IPTV interface $INTERFACE is down"
            update_interface_status "$INTERFACE" "down" "hotplug"
            notify_tracker "$INTERFACE"
        fi
        ;;

    wan_6|vwan1_6|vwan2_6)
        # IPv6地址/前缀变化时重选本机无源IPv6默认路由。
        ensure_ipv6_host_default || log "multiwan-ipv6" "Warning: failed to refresh host IPv6 default route after $INTERFACE $ACTION"
        ;;
esac