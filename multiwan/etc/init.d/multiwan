#!/bin/sh /etc/rc.common

. "${IPKG_INSTROOT}/lib/functions/network.sh"
. /lib/multiwan_common.sh

START=95
STOP=05
USE_PROCD=1

# --- Configuration ---
NFT_TABLE="multiwan"
NFT_FILE="/etc/multiwan/multiwan.nft"

WAN_TABLE=100
VWAN_TABLE=200
IPTV_TABLE=300

WAN_MARK=0x100
VWAN_MARK=0x200
IPTV_MARK=0x300

STATE_DIR="/var/run/multiwan"

# 确保 ip rule 规则的幂等性
setup_ip_rules() {
    log "Setting up IP rules..."
    
    # 删除可能存在的旧规则
    ip rule del priority 2001 2>/dev/null
    ip rule del priority 2002 2>/dev/null
    ip rule del priority 2003 2>/dev/null
    
    # 添加新规则
    ip rule add priority 2001 from all fwmark $WAN_MARK lookup $WAN_TABLE
    ip rule add priority 2002 from all fwmark $VWAN_MARK lookup $VWAN_TABLE
    ip rule add priority 2003 from all fwmark $IPTV_MARK lookup $IPTV_TABLE
}

remove_ip_rules() {
    log "Removing IP rules..."
    ip rule del priority 2001 2>/dev/null
    ip rule del priority 2002 2>/dev/null
    ip rule del priority 2003 2>/dev/null
}

# 启动单个接口的健康检查
start_tracker() {
    local interface=$1
    local enabled track_ip
    
    config_load multiwan
    config_get_bool enabled "$interface" 'enabled' '0'
    config_get track_ip "$interface" 'track_ip'
    
    [ "$enabled" -eq 0 ] && return
    [ -z "$track_ip" ] && return

    log "Starting health tracker for interface $interface"
    
    procd_open_instance "track_${interface}"
    procd_set_param command /usr/sbin/multiwan_tracker "$interface"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_running() {
    [ -d "$STATE_DIR" ]
}

start_service() {
    log "Starting Multi-WAN service..."
    
    # 创建状态目录
    mkdir -p "$STATE_DIR"
    
    # 提高 conntrack 表大小以支持更多连接
    sysctl -w net.netfilter.nf_conntrack_max=65536 >/dev/null 2>&1
    sysctl -w net.netfilter.nf_conntrack_buckets=16384 >/dev/null 2>&1

    log "Loading NFTables ruleset from $NFT_FILE..."
    # 先删除可能存在的旧表（忽略错误）
    nft delete table inet $NFT_TABLE 2>/dev/null || true
    
    # 加载NFT文件
    if [ -f "$NFT_FILE" ]; then
        nft -f "$NFT_FILE" || {
            log "ERROR: Failed to load NFT rules from $NFT_FILE"
            return 1
        }
        log "NFTables rules loaded successfully"
    else
        log "ERROR: NFT file $NFT_FILE not found!"
        return 1
    fi
    
    setup_ip_rules
    
    log "Setting up initial routes..."
    setup_route "wan" "$WAN_TABLE"
    setup_route "vwan1" "$VWAN_TABLE" 
    setup_route "iptv" "$IPTV_TABLE"
    
    # 初始化路由状态
    echo "balanced" > "$STATE_DIR/routing_state"
    
    # 启动各接口的健康检查
    config_load multiwan
    config_foreach start_tracker interface
    
    log "Multi-WAN service started."
}

stop_service() {
    log "Stopping Multi-WAN service..."
    remove_ip_rules
    nft delete table inet $NFT_TABLE 2>/dev/null
    ip route flush table $WAN_TABLE 2>/dev/null
    ip route flush table $VWAN_TABLE 2>/dev/null
    ip route flush table $IPTV_TABLE 2>/dev/null
    rm -rf "$STATE_DIR"
    log "Multi-WAN service stopped."
}

reload_service() {
    stop_service
    sleep 1
    start_service
}
