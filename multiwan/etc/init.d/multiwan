#!/bin/sh /etc/rc.common

. "${IPKG_INSTROOT}/lib/functions/network.sh"
. /lib/multiwan_common.sh

START=95
STOP=05
USE_PROCD=1
NFT_TABLE="multiwan"
NFT_FILE="/etc/multiwan/multiwan.nft"
WAN_TABLE=100
VWAN_TABLE=200
IPTV_TABLE=300
CMCC_TABLE=400
ROUTE_MARK_MASK=0x000f0000
WAN_MARK=0x00010000
VWAN_MARK=0x00020000
IPTV_MARK=0x00030000
CMCC_MARK=0x00040000
STATE_DIR="/var/run/multiwan"
NFT_RESTART_MARKER="/tmp/${NFT_TABLE}-restart-special.pending"
RESTART_SPECIAL_DIR="/tmp/${NFT_TABLE}-restart-special"
SPECIAL_SETS="special_udp_wan_51820 special_udp_vwan_51820 special_udp_wan_51821 special_udp_vwan_51821"

setup_ip_rules() {
    log "Setting up marked policy rules..."
    ip rule del priority 2001 2>/dev/null
    ip rule del priority 2002 2>/dev/null
    ip rule del priority 2003 2>/dev/null
    ip rule del priority 2004 2>/dev/null
    ip -6 rule del priority 2001 2>/dev/null
    ip -6 rule del priority 2002 2>/dev/null
    ip -6 rule del priority 2003 2>/dev/null
    ip -6 rule del priority 2004 2>/dev/null
    ip rule add priority 2001 from all fwmark $WAN_MARK/$ROUTE_MARK_MASK lookup $WAN_TABLE
    ip rule add priority 2002 from all fwmark $VWAN_MARK/$ROUTE_MARK_MASK lookup $VWAN_TABLE
    ip rule add priority 2003 from all fwmark $IPTV_MARK/$ROUTE_MARK_MASK lookup $IPTV_TABLE
    ip rule add priority 2004 from all fwmark $CMCC_MARK/$ROUTE_MARK_MASK lookup $CMCC_TABLE
    ip -6 rule add priority 2001 from all fwmark $WAN_MARK/$ROUTE_MARK_MASK lookup $WAN_TABLE
    ip -6 rule add priority 2002 from all fwmark $VWAN_MARK/$ROUTE_MARK_MASK lookup $VWAN_TABLE
    ip -6 rule add priority 2003 from all fwmark $IPTV_MARK/$ROUTE_MARK_MASK lookup $IPTV_TABLE
    ip -6 rule add priority 2004 from all fwmark $CMCC_MARK/$ROUTE_MARK_MASK lookup $CMCC_TABLE
}

remove_ip_rules() {
    log "Removing policy rules..."
    ip rule del priority 2001 2>/dev/null
    ip rule del priority 2002 2>/dev/null
    ip rule del priority 2003 2>/dev/null
    ip rule del priority 2004 2>/dev/null
    ip -6 rule del priority 2001 2>/dev/null
    ip -6 rule del priority 2002 2>/dev/null
    ip -6 rule del priority 2003 2>/dev/null
    ip -6 rule del priority 2004 2>/dev/null
}

save_special_sets() {
    local dir="$1" set dump
    mkdir -p "$dir" || return 1
    for set in $SPECIAL_SETS; do
        dump=$(nft list set inet "$NFT_TABLE" "$set" 2>/dev/null) || return 1
        printf '%s\n' "$dump" |
            sed -n '/elements = {/,/}/p' |
            sed 's/elements = {//; s/}//; s/expires [^,}]*/ /g' |
            tr '\n' ' ' > "$dir/$set.elements" || return 1
    done
}

restore_special_sets() {
    local dir="$1" set elements
    for set in $SPECIAL_SETS; do
        elements=$(grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}[[:space:]]*\.[[:space:]]*[0-9]{1,5}' "$dir/$set.elements" 2>/dev/null | sed -E 's/[[:space:]]+/ /g' | tr '\n' ',' | sed 's/,$//')
        [ -z "$elements" ] || nft add element inet "$NFT_TABLE" "$set" { $elements } || return 1
    done
}


check_nft_rules() {
    if nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then
        # Match restart's delete/load transaction; existing map elements must
        # not conflict with the replacement table during a dry run.
        printf 'delete table inet %s\ninclude "%s"\n' "$NFT_TABLE" "$NFT_FILE" | nft -c -f -
    else
        nft -c -f "$NFT_FILE"
    fi
}

start_tracker() {
    local interface=$1 enabled track_ip
    config_load multiwan
    config_get_bool enabled "$interface" enabled 0
    config_get track_ip "$interface" track_ip
    [ "$enabled" -eq 0 ] && return
    [ -z "$track_ip" ] && return
    log "Starting health tracker for interface $interface"
    procd_open_instance "track_${interface}"
    procd_set_param command /usr/sbin/multiwan_tracker "$interface"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_running() { [ -d "$STATE_DIR" ]; }


start_service() {
    local special_dir
    log "Starting Multi-WAN service..."
    mkdir -p "$STATE_DIR" || return 1
    sysctl -w net.netfilter.nf_conntrack_max=65536 >/dev/null 2>&1
    sysctl -w net.netfilter.nf_conntrack_buckets=16384 >/dev/null 2>&1

    if nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then
        special_dir="$STATE_DIR/special"
        rm -rf "$special_dir"
        if ! save_special_sets "$special_dir"; then
            log "ERROR: Failed to save current WireGuard endpoint mappings"
            return 1
        fi
    elif [ -f "$NFT_RESTART_MARKER" ] && [ -d "$RESTART_SPECIAL_DIR" ]; then
        special_dir="$RESTART_SPECIAL_DIR"
    else
        special_dir="$STATE_DIR/special"
        mkdir -p "$special_dir" || return 1
    fi

    if ! check_nft_rules; then
        log "ERROR: NFT rules failed validation for $NFT_FILE"
        return 1
    fi
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    if ! nft -f "$NFT_FILE"; then
        log "ERROR: Failed to load NFT rules from $NFT_FILE"
        return 1
    fi
    if ! refresh_special_udp_sources; then
        log "WARNING: Cannot determine current PPPoE WireGuard source addresses; WireGuard endpoint mappings stay unset until the interfaces dial"
    fi
    if ! restore_special_sets "$special_dir"; then
        log "ERROR: Failed to restore WireGuard endpoint mappings"
        return 1
    fi

    /usr/sbin/multiwan-isp-update apply 2>/dev/null || log "WARNING: Operator CIDR cache unavailable; destination sets remain empty"
    restore_force_sets || log "WARNING: Failed to restore some forced egress entries"
    setup_ip_rules
    log "Setting up initial routes..."
    rm -f "$STATE_DIR"/wan_status "$STATE_DIR"/vwan1_status "$STATE_DIR"/vwan2_status "$STATE_DIR"/iptv_status
    if setup_route wan "$WAN_TABLE"; then echo up > "$STATE_DIR/wan_status"; else echo down > "$STATE_DIR/wan_status"; fi
    if setup_route vwan1 "$VWAN_TABLE"; then echo up > "$STATE_DIR/vwan1_status"; else echo down > "$STATE_DIR/vwan1_status"; fi
    if setup_route vwan2 "$CMCC_TABLE"; then echo up > "$STATE_DIR/vwan2_status"; else echo down > "$STATE_DIR/vwan2_status"; fi
    if setup_route iptv "$IPTV_TABLE"; then echo up > "$STATE_DIR/iptv_status"; else echo down > "$STATE_DIR/iptv_status"; fi
    rm -f "$STATE_DIR/routing_state"
    if ! update_global_routing startup; then
        log "ERROR: Failed to apply initial routing policy"
        return 1
    fi
    rm -f "$NFT_RESTART_MARKER"
    rm -rf "$RESTART_SPECIAL_DIR"
    config_load multiwan
    config_foreach start_tracker interface
    log "Multi-WAN service started."
}

stop_service() {
    local special_dir="$RESTART_SPECIAL_DIR"
    log "Stopping Multi-WAN service..."
    rm -rf "$special_dir"
    rm -f "$NFT_RESTART_MARKER"
    if nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then
        if save_special_sets "$special_dir"; then
            if ! : > "$NFT_RESTART_MARKER"; then
                log "ERROR: Failed to mark saved WireGuard endpoint mappings"
                rm -rf "$special_dir"
            fi
        else
            log "ERROR: Failed to save WireGuard endpoint mappings"
            rm -rf "$special_dir"
        fi
    fi
    remove_ip_rules
    nft delete table inet "$NFT_TABLE" 2>/dev/null
    ip route flush table "$WAN_TABLE" 2>/dev/null
    ip route flush table "$VWAN_TABLE" 2>/dev/null
    ip route flush table "$IPTV_TABLE" 2>/dev/null
    ip route flush table "$CMCC_TABLE" 2>/dev/null
    ip -6 route flush table "$WAN_TABLE" 2>/dev/null
    ip -6 route flush table "$VWAN_TABLE" 2>/dev/null
    ip -6 route flush table "$IPTV_TABLE" 2>/dev/null
    ip -6 route flush table "$CMCC_TABLE" 2>/dev/null
    rm -rf "$STATE_DIR"
    log "Multi-WAN service stopped."
}

reload_service() {
    stop_service
    sleep 1
    start_service
}
