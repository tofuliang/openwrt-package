START=99
STOP=10
USE_PROCD=1

CONFIG=accesscontrol

. "${ACCESSCONTROL_CALENDAR_LIB:-/usr/libexec/accesscontrol-calendar.sh}"
ACCESSCONTROL_FIREWALL_INCLUDE=${ACCESSCONTROL_FIREWALL_INCLUDE:-/var/etc/accesscontrol.include}

# Debug switch - set to 1 to enable debug output, 0 to disable
DEBUG=1

# Debug function
debug_log() {
	[ "$DEBUG" = "1" ] && echo "[DEBUG] $(date '+%Y-%m-%d %H:%M:%S') - $*" >&2
}

# 获取系统UTC偏移（小时数）
get_utc_offset_hours() {
	local offset=$(date +%z)  # 格式如: +0800, -0500
	local sign=${offset:0:1}
	local hours=${offset:1:2}
	
	# 移除前导零避免八进制解释
	hours=$(echo "$hours" | sed 's/^0*//')
	[ -z "$hours" ] && hours=0
	
	if [ "$sign" = "-" ]; then
		echo "-$hours"
	else
		echo "$hours"
	fi
}

# 将本地时间转换为UTC时间
convert_local_to_utc() {
	local local_time="$1"  # 格式: HH:MM
	local offset_hours=$(get_utc_offset_hours)
	
	local hour=$(echo "$local_time" | cut -d: -f1)
	local min=$(echo "$local_time" | cut -d: -f2)
	
	# 移除前导零
	hour=$(echo "$hour" | sed 's/^0*//')
	min=$(echo "$min" | sed 's/^0*//')
	[ -z "$hour" ] && hour=0
	[ -z "$min" ] && min=0
	
	# 转换为UTC时间
	local utc_hour=$((hour - offset_hours))
	
	# 处理跨日情况
	local day_offset=0
	if [ "$utc_hour" -lt 0 ]; then
		utc_hour=$((utc_hour + 24))
		day_offset=-1
	elif [ "$utc_hour" -ge 24 ]; then
		utc_hour=$((utc_hour - 24))
		day_offset=1
	fi
	
	printf "%02d:%02d:%d" "$utc_hour" "$min" "$day_offset"
}

# 调整星期几（考虑日期偏移）
adjust_weekdays_for_day_offset() {
	local weekdays="$1"
	local day_offset="$2"
	
	if [ "$day_offset" = "0" ]; then
		echo "$weekdays"
		return
	fi
	
	# 星期几映射
	local days="Sunday Monday Tuesday Wednesday Thursday Friday Saturday"
	local adjusted=""
	
	# 处理输入的weekdays字符串（可能包含逗号）
	local weekdays_clean=$(echo "$weekdays" | sed 's/,/ /g')
	
	for day in $weekdays_clean; do
		# 找到当前星期几的位置
		local pos=0
		for d in $days; do
			if [ "$d" = "$day" ]; then
				break
			fi
			pos=$((pos + 1))
		done
		
		# 根据日期偏移调整
		local new_pos=$((pos + day_offset))
		if [ "$new_pos" -lt 0 ]; then
			new_pos=$((new_pos + 7))
		elif [ "$new_pos" -ge 7 ]; then
			new_pos=$((new_pos - 7))
		fi
		
		# 获取调整后的星期几
		local count=0
		for d in $days; do
			if [ "$count" = "$new_pos" ]; then
				if [ -z "$adjusted" ]; then
					adjusted="$d"
				else
					adjusted="$adjusted,$d"
				fi
				break
			fi
			count=$((count + 1))
		done
	done
	
	echo "$adjusted"
}



add_rules() {
	debug_log "Starting add_rules function"
	
	debug_log "Loading config: $CONFIG"
	config_load "$CONFIG"
	
	debug_log "Using config_foreach to process rules"
	config_foreach process_legacy_rule rule
	
	debug_log "Finished add_rules function"
}

# Only holiday-mode rules are placed in the rolling child chain.
process_legacy_rule() {
	local respect_holidays
	config_get respect_holidays "$1" respect_holidays 0
	[ "$respect_holidays" = 1 ] || process_rule "$1"
}

# Keep the old weekday commands unchanged; calendar fallback collects the same
# commands into the child chain's atomic transaction instead of running them.
accesscontrol_add_rule() {
	if [ -n "${ACCESSCONTROL_RULE_BATCH:-}" ]; then
		{
			printf 'add rule inet fw4 %s ' "$ACCESSCONTROL_RULE_CHAIN"
			printf '%s ' "$@"
			printf '\n'
		} >> "$ACCESSCONTROL_RULE_BATCH" || CALENDAR_BUILD_FAILED=1
	else
		TZ=UTC nft add rule inet fw4 accesscontrol "$@"
	fi
}

process_rule() {
	local section="$1"
	local enabled macaddr start_time end_time
	local monday tuesday wednesday thursday friday saturday sunday
	local weekdays=""
	
	debug_log "Processing rule section: $section"
	
	config_get enabled "$section" "enabled" "0"
	debug_log "Rule $section enabled: $enabled"

	config_get macaddr "$section" "macaddr"
	debug_log "Rule $section macaddr: $macaddr"

	[ "$enabled" != "1" ] && {
		debug_log "Rule $section is disabled, skipping"
		return
	}
	
	config_get macaddr "$section" "macaddr"
	config_get start_time "$section" "start_time"
	config_get end_time "$section" "end_time"
	
	debug_log "Rule $section - MAC: $macaddr, Start: $start_time, End: $end_time"
	
	[ -z "$macaddr" ] || [ -z "$start_time" ] || [ -z "$end_time" ] && {
		debug_log "Rule $section missing required parameters, skipping"
		return
	}
	
	config_get monday "$section" "monday" "1"
	config_get tuesday "$section" "tuesday" "1"
	config_get wednesday "$section" "wednesday" "1"
	config_get thursday "$section" "thursday" "1"
	config_get friday "$section" "friday" "1"
	config_get saturday "$section" "saturday" "1"
	config_get sunday "$section" "sunday" "1"
	
	[ "$monday" = "1" ] && weekdays="${weekdays}Monday,"
	[ "$tuesday" = "1" ] && weekdays="${weekdays}Tuesday,"
	[ "$wednesday" = "1" ] && weekdays="${weekdays}Wednesday,"
	[ "$thursday" = "1" ] && weekdays="${weekdays}Thursday,"
	[ "$friday" = "1" ] && weekdays="${weekdays}Friday,"
	[ "$saturday" = "1" ] && weekdays="${weekdays}Saturday,"
	[ "$sunday" = "1" ] && weekdays="${weekdays}Sunday"
	
	weekdays=$(echo "$weekdays" | sed 's/,$//')
	
	debug_log "Rule $section weekdays: $weekdays"
	
	if [ -n "$weekdays" ]; then
		debug_log "Adding nftables rules for $section (MAC: $macaddr, Time: $start_time-$end_time, Days: $weekdays)"
		
		# 将本地时间转换为UTC时间
		local start_result=$(convert_local_to_utc "$start_time")
		local end_result=$(convert_local_to_utc "$end_time")
		
		local start_utc_time=$(echo "$start_result" | cut -d: -f1,2)
		local start_day_offset=$(echo "$start_result" | cut -d: -f3)
		local end_utc_time=$(echo "$end_result" | cut -d: -f1,2)
		local end_day_offset=$(echo "$end_result" | cut -d: -f3)
		
		debug_log "Time conversion - Local: $start_time-$end_time -> UTC: $start_utc_time-$end_utc_time"
		debug_log "Day offsets - Start: $start_day_offset, End: $end_day_offset"
		
		# 检查UTC时间是否跨日（需要拆分规则）
		local start_hour=$(echo "$start_utc_time" | cut -d: -f1 | sed 's/^0*//')
		local end_hour=$(echo "$end_utc_time" | cut -d: -f1 | sed 's/^0*//')
		local start_min=$(echo "$start_utc_time" | cut -d: -f2 | sed 's/^0*//')
		local end_min=$(echo "$end_utc_time" | cut -d: -f2 | sed 's/^0*//')
		[ -z "$start_hour" ] && start_hour=0
		[ -z "$end_hour" ] && end_hour=0
		[ -z "$start_min" ] && start_min=0
		[ -z "$end_min" ] && end_min=0
		
		# 使用UTC时间添加nftables规则
		if [ "$start_hour" -gt "$end_hour" ] || 
		   ([ "$start_hour" -eq "$end_hour" ] && [ "$start_min" -gt "$end_min" ]); then
			debug_log "UTC cross-midnight time range detected, splitting into two rules"
			
			# 规则1: 从start_utc_time到23:59
			# 调整开始时间对应的星期几
			local start_weekdays="$weekdays"
			# if [ "$start_day_offset" != "0" ]; then
			# 	start_weekdays=$(adjust_weekdays_for_day_offset "$weekdays" "$start_day_offset")
			# fi
			local nft_start_weekdays="{ $start_weekdays }"
			
			debug_log "Rule 1 (UTC) - Time: $start_utc_time-23:59, Days: $start_weekdays"
			accesscontrol_add_rule \
				ether saddr "$macaddr" \
				meta hour \"$start_utc_time\"-\"23:59\" meta day $nft_start_weekdays \
				counter drop \
				comment \"AccessControl $macaddr evening\"
			
			# 规则2: 从00:00到end_utc_time
			# 调整结束时间对应的星期几
			local end_weekdays="$weekdays"
			# if [ "$end_day_offset" != "0" ]; then
			# 	end_weekdays=$(adjust_weekdays_for_day_offset "$weekdays" "$end_day_offset")
			# fi
			local nft_end_weekdays="{ $end_weekdays }"
			
			debug_log "Rule 2 (UTC) - Time: 00:00-$end_utc_time, Days: $end_weekdays"
			accesscontrol_add_rule \
				ether saddr "$macaddr" \
				meta hour \"00:00\"-\"$end_utc_time\" meta day $nft_end_weekdays \
				counter drop \
				comment \"AccessControl $macaddr morning\"
		else
			# 正常UTC时间范围，单条规则
			# 调整星期几（如果有日期偏移）
			local adjusted_weekdays="$weekdays"
			# if [ "$start_day_offset" != "0" ] || [ "$end_day_offset" != "0" ]; then
			# 	# 选择合适的日期偏移（优先使用开始时间的偏移）
			# 	local offset="$start_day_offset"
			# 	[ "$offset" = "0" ] && offset="$end_day_offset"
			# 	if [ "$offset" != "0" ]; then
			# 		adjusted_weekdays=$(adjust_weekdays_for_day_offset "$weekdays" "$offset")
			# 	fi
			# fi
			local nft_weekdays="{ $adjusted_weekdays }"
			
			debug_log "Normal UTC time range, single rule: $start_utc_time-$end_utc_time, Days: $adjusted_weekdays"
			accesscontrol_add_rule \
				ether saddr "$macaddr" \
				meta hour \"$start_utc_time\"-\"$end_utc_time\" meta day $nft_weekdays \
				counter drop \
				comment \"AccessControl $macaddr\"
		fi
		
		debug_log "Added nftables rule(s) for $section"
	else
		debug_log "No weekdays selected for rule $section, skipping"
	fi
}

validate_section_accesscontrol() {
	uci_validate_section accesscontrol global "${1}" \
		'enabled:bool:0'
}

start_service() {
	local enabled CALENDAR_SESSION

	debug_log "Starting accesscontrol service"
	validate_section_accesscontrol global || {
		debug_log "Validation failed for global section"
		echo "validation failed"
		return 1
	}

	mkdir -p "${ACCESSCONTROL_FIREWALL_INCLUDE%/*}"
	cat > "$ACCESSCONTROL_FIREWALL_INCLUDE" <<-EOF
	/etc/init.d/accesscontrol start
	EOF

	calendar_lock || return 1
	calendar_clear_session
	remove_rules
	[ "$enabled" = 1 ] || {
		calendar_unlock
		debug_log "Service is disabled, exiting"
		return 0
	}
	if ! nft list table inet fw4 >/dev/null 2>&1; then
		calendar_unlock
		debug_log "fw4 table not found, this may indicate firewall4 is not running"
		return 1
	fi
	if ! nft add chain inet fw4 accesscontrol; then
		calendar_unlock
		return 1
	fi
	nft insert rule inet fw4 forward counter jump accesscontrol comment \"AccessControl Forward\"
	add_rules
	calendar_count_rules
	if [ "$CALENDAR_RULE_COUNT" -gt 0 ]; then
		if ! nft add chain inet fw4 accesscontrol_calendar ||
		   ! nft add rule inet fw4 accesscontrol jump accesscontrol_calendar comment \"AccessControl Calendar\" ||
		   ! calendar_new_session; then
			calendar_clear_session
			remove_rules
			calendar_unlock
			return 1
		fi
		# Apply only local caches here. The daemon downloads after firewall start.
		if ! calendar_refresh_locked "$CALENDAR_SESSION"; then
			# The helper records apply-error and retains any prior child chain;
			# startup must not relabel that failure as unavailable.
			debug_log "Initial holiday calendar apply failed; watcher will retry"
		fi
		procd_open_instance calendar
		procd_set_param command /usr/libexec/accesscontrol-calendar-watch "$CALENDAR_SESSION"
		procd_set_param respawn 3600 5 5
		# GNU timeout has a five-second TERM-to-KILL grace period; let the
		# watcher reap it and remove private work before procd escalates.
		procd_set_param term_timeout 10
		procd_close_instance
	fi
	calendar_unlock
	debug_log "Accesscontrol service started successfully"
}

# The caller holds the calendar lock, so a terminating watcher cannot restore
# rules between removing the forward jump and deleting the child chain.
remove_rules() {
	nft -a list chain inet fw4 forward 2>/dev/null | grep "AccessControl Forward" | while read -r line; do
		handle=$(echo "$line" | sed -n 's/.*# handle \([0-9]*\).*/\1/p')
		[ -z "$handle" ] || nft delete rule inet fw4 forward handle "$handle" 2>/dev/null
	done
	if nft list chain inet fw4 accesscontrol >/dev/null 2>&1; then
		nft flush chain inet fw4 accesscontrol 2>/dev/null
	fi
	if nft list chain inet fw4 accesscontrol_calendar >/dev/null 2>&1; then
		nft flush chain inet fw4 accesscontrol_calendar 2>/dev/null
		nft delete chain inet fw4 accesscontrol_calendar 2>/dev/null
	fi
	nft delete chain inet fw4 accesscontrol 2>/dev/null
	return 0
}

stop_service() {
	debug_log "Stopping accesscontrol service"
	calendar_lock || return 1
	calendar_clear_session
	remove_rules
	calendar_unlock
	# rc.common stops the procd instance immediately after this returns.
	debug_log "Accesscontrol service stopped successfully"
}

reload_service() {
	# Use rc.common's procd wrapper so disabled or changed rules also replace
	# the watcher instance. The worker itself never restarts its own service.
	start
}

service_triggers() {
	debug_log "Setting up service triggers"
	procd_add_reload_trigger "accesscontrol"
	debug_log "Service triggers configured"
}
