# Multi-WAN Configuration
# 基于您现有的mwan3配置转换而来

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option reliability '2'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '4'
	option size '56'
	option max_ttl '60'
	option failure_interval '5'
	option recovery_interval '3'
	option auto_redial '1'
	option redial_threshold '10'
	option redial_interval '300'
	list track_ip '119.29.29.29'
	list track_ip '223.6.6.6'

config interface 'vwan1'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	option count '2'
	option timeout '2'
	option interval '5'
	option down '4'
	option up '3'
	option size '56'
	option max_ttl '60'
	option failure_interval '5'
	option recovery_interval '5'
	option auto_redial '1'
	option redial_threshold '8'
	option redial_interval '300'
	list track_ip '223.6.6.6'
	list track_ip '119.29.29.29'

config interface 'iptv'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '3'
	option size '56'
	option max_ttl '60'
	option failure_interval '5'
	option recovery_interval '5'
	option auto_redial '1'
	option redial_threshold '6'
	option redial_interval '600'
	list track_ip '183.59.59.26'

config globals 'globals'
	option enabled '1'
	option logging '1'
	option loglevel 'info'